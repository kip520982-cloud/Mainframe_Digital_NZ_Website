{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    }
  ],
  "headers": [
    {
      "source": "/(admin|demo)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/industries",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/industries/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
